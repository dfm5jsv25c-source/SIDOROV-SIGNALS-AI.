
import os
import logging
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

logging.basicConfig(level=logging.INFO)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🔥 SIDOROV SIGNALS AI\n\n"
        "Бот успешно запущен!\n\n"
        "📊 Режим: DEMO\n"
        "💱 Анализ: в разработке\n\n"
        "Пока реальные сигналы не подключены.\n"
        "Используй /help для помощи."
    )

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "SIDOROV SIGNALS AI\n\n"
        "/start — запуск бота\n"
        "/help — помощь\n\n"
        "Учебный режим. Сделки автоматически не открываются."
    )

def main():
    token = os.getenv("BOT_TOKEN")
    if not token:
        raise RuntimeError("BOT_TOKEN не задан в Render")

    app = Application.builder().token(token).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.run_polling()

if __name__ == "__main__":
    main()

